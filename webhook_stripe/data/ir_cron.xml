<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Крон: каждую минуту дергает воркер Stripe.
       Привязка к модели по стандартному ref="model_<model_name>" -->
  <record id="ir_cron_stripe_consume" model="ir.cron">
    <field name="name">Stripe: consume webhook events</field>
    <field name="active">True</field>
    <field name="model_id" ref="model_stripe_webhook_worker"/>
    <field name="state">code</field>
    <field name="code">model.cron_consume_stripe()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
  </record>
</odoo>
